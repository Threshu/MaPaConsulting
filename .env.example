# Formspree Configuration
# Get your endpoint from https://formspree.io/
NUXT_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Cloudflare Turnstile (spam protection for the contact form)
# https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty to disable. For local testing use the Cloudflare test keys:
#   site key   1x00000000000000000000AA  (always passes)
#   secret key 1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
